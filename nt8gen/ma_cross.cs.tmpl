// $HEADER
#region Using declarations
using System;
using System.ComponentModel.DataAnnotations;
using NinjaTrader.Cbi;
using NinjaTrader.Data;
using NinjaTrader.NinjaScript;
using NinjaTrader.NinjaScript.Indicators;
#endregion

namespace NinjaTrader.NinjaScript.Strategies
{
	/// <summary>
	/// Moving-average cross, generated by PropSim.
	///
	/// Calculate is OnBarClose, so the cross is detected on the closing bar and the
	/// market order fills at the NEXT bar's open. That is deliberate and it matches
	/// the engine these values came from: acting on the signal bar's own close would
	/// be lookahead.
	///
	/// It only enters when FLAT. The engine that produced these parameters holds one
	/// position at a time and skips a cross that arrives while a trade is open, so a
	/// version that reversed on every cross would be a different strategy with the
	/// same numbers on it.
	/// </summary>
	public class $CLASS : Strategy
	{
		private SMA fast;
		private SMA slow;

		protected override void OnStateChange()
		{
			if (State == State.SetDefaults)
			{
				Name        = "$CLASS";
				Description = "$DESCRIPTION";
				Calculate   = Calculate.OnBarClose;

				EntriesPerDirection          = 1;
				EntryHandling                = EntryHandling.AllEntries;
				IsExitOnSessionCloseStrategy = true;
				ExitOnSessionCloseSeconds    = 60;
				IncludeCommission            = true;

				FastPeriod     = $fast;
				SlowPeriod     = $slow;
				StopTicks      = $stop_ticks;
				RewardMultiple = $rr;
			}
			else if (State == State.DataLoaded)
			{
				fast = SMA(Close, FastPeriod);
				slow = SMA(Close, SlowPeriod);
			}
		}

		protected override void OnBarUpdate()
		{
			if (CurrentBar < SlowPeriod + 2)
				return;

			// One position at a time, as in the engine that produced these values.
			if (Position.MarketPosition != MarketPosition.Flat)
				return;

			if (CrossAbove(fast, slow, 1))
			{
				EnterLong("MA Long");
				SetStopLoss("MA Long", CalculationMode.Ticks, StopTicks, false);
				SetProfitTarget("MA Long", CalculationMode.Ticks, StopTicks * RewardMultiple);
			}
			else if (CrossBelow(fast, slow, 1))
			{
				EnterShort("MA Short");
				SetStopLoss("MA Short", CalculationMode.Ticks, StopTicks, false);
				SetProfitTarget("MA Short", CalculationMode.Ticks, StopTicks * RewardMultiple);
			}
		}

		#region Parameters
		[NinjaScriptProperty]
		[Range(2, 500)]
		[Display(Name = "Fast period", Description = "fast moving average, bars",
			Order = 1, GroupName = "PropSim")]
		public int FastPeriod { get; set; }

		[NinjaScriptProperty]
		[Range(3, 2000)]
		[Display(Name = "Slow period", Description = "slow moving average, bars",
			Order = 2, GroupName = "PropSim")]
		public int SlowPeriod { get; set; }

		[NinjaScriptProperty]
		[Range(1, 1000)]
		[Display(Name = "Stop ticks", Description = "stop distance in ticks",
			Order = 3, GroupName = "PropSim")]
		public int StopTicks { get; set; }

		[NinjaScriptProperty]
		[Range(0.1, 20)]
		[Display(Name = "Reward multiple", Description = "target as a multiple of the stop",
			Order = 4, GroupName = "PropSim")]
		public double RewardMultiple { get; set; }
		#endregion
	}
}
