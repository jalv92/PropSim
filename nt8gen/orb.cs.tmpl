// $HEADER
#region Using declarations
using System;
using System.ComponentModel.DataAnnotations;
using NinjaTrader.Cbi;
using NinjaTrader.Data;
using NinjaTrader.NinjaScript;
#endregion

namespace NinjaTrader.NinjaScript.Strategies
{
	/// <summary>
	/// Opening-range breakout, generated by PropSim.
	///
	/// The range is the high and low of the first RangeMinutes of the RTH session.
	/// After that window, a stop-market order rests at each edge, so the entry
	/// happens the instant price trades through the level -- which is what PropSim
	/// measured against, tick by tick. Entering at a bar's open instead would use
	/// end-of-bar information to buy below the level, and that version scored a
	/// 79% win rate in testing purely from the lookahead.
	/// </summary>
	public class $CLASS : Strategy
	{
		private double rangeHigh;
		private double rangeLow;
		private int    rangeDay;
		private bool   tradedToday;

		protected override void OnStateChange()
		{
			if (State == State.SetDefaults)
			{
				Name        = "$CLASS";
				Description = "$DESCRIPTION";
				Calculate   = Calculate.OnBarClose;

				// One position at a time, matching the engine that produced these
				// values: it never holds two.
				EntriesPerDirection            = 1;
				EntryHandling                  = EntryHandling.AllEntries;
				IsExitOnSessionCloseStrategy   = true;
				ExitOnSessionCloseSeconds      = 60;
				IncludeCommission              = true;

				// PropSim resolves every fill on the tick tape. To be measured on
				// the same basis here, the Strategy Analyzer needs Order fill
				// resolution = High with type Tick and value 1. "High" alone leaves
				// the fill series at Minute/1, which still straddles this stop.
				RangeMinutes    = $range_min;
				StopTicks       = $stop_ticks;
				RewardMultiple  = $rr;
				OnePerDay       = $one_per_day;
				SessionOpenTime = $open_hhmm;
			}
			else if (State == State.Configure)
			{
				rangeDay = -1;
			}
		}

		protected override void OnBarUpdate()
		{
			if (CurrentBar < 2)
				return;

			int today = ToDay(Time[0]);
			if (today != rangeDay)
			{
				rangeDay    = today;
				rangeHigh   = double.MinValue;
				rangeLow    = double.MaxValue;
				tradedToday = false;
			}

			int now      = ToTime(Time[0]);
			int openTime = SessionOpenTime;
			int rangeEnd = AddMinutes(openTime, RangeMinutes);

			// Inside the opening window: build the range, take no trade.
			if (now > openTime && now <= rangeEnd)
			{
				rangeHigh = Math.Max(rangeHigh, High[0]);
				rangeLow  = Math.Min(rangeLow, Low[0]);
				return;
			}
			if (now <= openTime || rangeHigh == double.MinValue)
				return;
			if (OnePerDay && tradedToday)
				return;
			if (Position.MarketPosition != MarketPosition.Flat)
				return;

			double stop = StopTicks * TickSize;

			// Resting stop-market orders at both edges. Whichever the market
			// reaches first fills at that level; the other is cancelled by
			// EntriesPerDirection once a position exists.
			EnterLongStopMarket(rangeHigh, "ORB Long");
			EnterShortStopMarket(rangeLow, "ORB Short");

			SetStopLoss("ORB Long",  CalculationMode.Ticks, StopTicks, false);
			SetProfitTarget("ORB Long",  CalculationMode.Ticks, StopTicks * RewardMultiple);
			SetStopLoss("ORB Short", CalculationMode.Ticks, StopTicks, false);
			SetProfitTarget("ORB Short", CalculationMode.Ticks, StopTicks * RewardMultiple);
		}

		protected override void OnExecutionUpdate(Execution execution, string executionId,
			double price, int quantity, MarketPosition marketPosition, string orderId,
			DateTime time)
		{
			if (execution.Order != null && execution.Order.OrderState == OrderState.Filled
				&& execution.IsEntry)
				tradedToday = true;
		}

		private int AddMinutes(int hhmmss, int minutes)
		{
			int h = hhmmss / 10000;
			int m = (hhmmss / 100) % 100;
			int s = hhmmss % 100;
			int total = h * 60 + m + minutes;
			return ((total / 60) % 24) * 10000 + (total % 60) * 100 + s;
		}

		#region Parameters
		[NinjaScriptProperty]
		[Range(1, 240)]
		[Display(Name = "Range minutes", Description = "length of the opening range",
			Order = 1, GroupName = "PropSim")]
		public int RangeMinutes { get; set; }

		[NinjaScriptProperty]
		[Range(1, 1000)]
		[Display(Name = "Stop ticks", Description = "stop distance in ticks",
			Order = 2, GroupName = "PropSim")]
		public int StopTicks { get; set; }

		[NinjaScriptProperty]
		[Range(0.1, 20)]
		[Display(Name = "Reward multiple", Description = "target as a multiple of the stop",
			Order = 3, GroupName = "PropSim")]
		public double RewardMultiple { get; set; }

		[NinjaScriptProperty]
		[Display(Name = "One per day", Description = "at most one trade per session",
			Order = 4, GroupName = "PropSim")]
		public bool OnePerDay { get; set; }

		[NinjaScriptProperty]
		[Range(0, 235959)]
		[Display(Name = "Session open (HHMMSS)", Description = "start of the opening range",
			Order = 5, GroupName = "PropSim")]
		public int SessionOpenTime { get; set; }
		#endregion
	}
}
