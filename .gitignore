# Never commit market data or a user's trades. The tool is public; the data is
# not -- CME 3.2(ii) forbids supplying it to another party or location.
*.ncd
*.nrd
*.pkl
*.sqlite
data/
# build output
build/*.spec.bak
dist/
dist_installer/
# ...except the NinjaScript archive the README links to: it is the one-click
# install, so it has to be downloadable from the repo.
!nt8/dist/
!nt8/dist/PropSimExport.zip
__pycache__/
*.pyc
# the user's own settings and downloaded rules live outside the repo anyway
.prop-sim/
