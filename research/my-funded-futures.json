        "rapid_sim_hwm_ratchet": {
          "question": "Does the Rapid sim-funded intraday trailing HWM ratchet on unrealized equity highs, or only on closed-trade balance highs?",
          "answer": "UNREALIZED. The HWM ratchets on running equity including open-position gains.",
          "verified": true,
          "quote": "the trailing drawdown is calculated intraday based on your peak balance, which includes both realized and unrealized gains",
          "quote_continues": "if your account value declines, even during an open trade, the drawdown limit remains unchanged",
          "implication": "Rapid sim funded is hwm_basis:intraday_equity_incl_unrealized AND breach_basis:intraday_equity_incl_unrealized — both axes unrealized. mff_sim.py's ponytail comment (realtime trailing approximated at trade-close granularity) is therefore optimistic on the ratchet side too, not only the breach side.",
          "source_url": "https://help.myfundedfutures.com/en/articles/12802721-intraday-drawdown-explained",
          "page_last_updated": "2026-01-08",
          "retrieved": "2026-07-25"
        },
        "consistency_blocking_vs_target_increase": {
          "question": "Does a consistency violation block passing until the ratio recovers, or does the profit target itself increase (Topstep-style)?",
          "answer": "UNVERIFIED — the firm's own page is internally ambiguous and does not state either mechanic explicitly.",
          "verified": false,
          "quote_remedy": "Exceeding the 50% consistency target does not breach the account. Traders who achieve more than 50% of their total profit target in one day simply need to trade additional days until consistency is met.",
          "quote_formula": "Total profit target / 2 = Max Daily Profit",
          "ambiguity": "The two quotes cannot both be literally true. If the cap is a FIXED profit_target/2 (the stated formula), trading additional days can never cure a violation — the best day is already in the books. The stated remedy only works if the denominator is REALIZED TOTAL PROFIT, i.e. you must keep trading until total_profit >= 2 * best_day, which is functionally an increased effective target. MFF never describes it as a target increase.",
          "do_not_assume": "Do not encode either mechanic as verified. Model both and flag the variant in unmodeled_rules until support confirms.",
          "how_to_close": "Support ticket, or observe the dashboard's pass state on an eval where day 1 exceeds 50% of the target",
          "source_url": "https://help.myfundedfutures.com/en/articles/11994562-consistency-rule-at-my-funded-futures",
          "page_last_updated": "2026-02-27",
          "retrieved": "2026-07-25"
        }
